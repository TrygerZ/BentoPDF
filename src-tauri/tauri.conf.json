{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "BentoPDF",
    "version":  "2.8.7",
    "identifier":  "com.bentopdf.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "node scripts/tauri-before-build.mjs",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "BentoPDF",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  1024,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027 asset: tauri: ipc: http://asset.localhost; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027 blob:; worker-src \u0027self\u0027 blob:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 asset: data: blob:; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 asset: tauri: ipc: http://asset.localhost; media-src \u0027self\u0027 asset: blob:; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "category":  "Productivity",
                   "shortDescription":  "Privacy-first PDF toolkit — 100% offline",
                   "longDescription":  "BentoPDF Desktop — 118 PDF tools that run 100% on your device. No uploads, no signup, works offline.",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "fileAssociations":  [
                                            {
                                                "ext":  [
                                                            "pdf"
                                                        ],
                                                "name":  "PDF Document",
                                                "description":  "Open with BentoPDF",
                                                "mimeType":  "application/pdf",
                                                "role":  "Editor"
                                            }
                                        ],
                   "windows":  {
                                   "certificateThumbprint":  null,
                                   "digestAlgorithm":  "sha256",
                                   "wix":  {
                                               "language":  "en-US"
                                           },
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "English"
                                                              ],
                                                "displayLanguageSelector":  false
                                            }
                               },
                   "macOS":  {
                                 "entitlements":  null,
                                 "exceptionDomain":  "",
                                 "signingIdentity":  null
                             },
                   "linux":  {
                                 "deb":  {
                                             "depends":  [

                                                         ]
                                         },
                                 "appimage":  {
                                                  "bundleMediaFramework":  false
                                              }
                             },
                   "resources":  [
                                     "../public/wasm/libreoffice/*"
                                 ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6MC4=",
                                    "endpoints":  [
                                                      "https://github.com/alam00000/bentopdf/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}